# Source this file's host-local copy before live simulator commands:
#   set -a; . ./.env; set +a
# Values are host-local; never commit the copy or any credential.

# The registered execution host this shell runs on: the id of this machine's
# ora/orchestrator/hosts/<id>.yaml (template: examples/hosts/example-host.yaml). Left empty on
# purpose; every live RunSpec names it and nothing assumes a machine.
ORA_EXECUTION_HOST=

# RoboTwin: the vendored install (revision cf4872cc) and its isolated interpreter.
ROBOTWIN_ROOT=/absolute/path/to/pinned/RoboTwin
ROBOTWIN_PYTHON=/absolute/path/to/robotwin/python

# CuRobo motion planner (v0.7.8 pin), shared by RoboTwin and the LIBERO planner worker.
CUROBO_ROOT=/absolute/path/to/pinned/curobo
CUROBO_PYTHON=/absolute/path/to/robotwin/python

# LIBERO-Pro direct driver: pinned code, pinned dataset and the isolated interpreter.
# The direct driver needs no RLinf, no LIBERO_TYPE and no global PYTHONPATH; RLINF_ROOT
# matters only to historical RLinf-driver profiles.
LIBERO_PRO_PYTHON=/absolute/path/to/libero-pro/python
LIBERO_PRO_ROOT=/absolute/path/to/pinned/LIBERO-PRO
LIBERO_PRO_DATA_ROOT=/absolute/path/to/pinned/LIBERO-Pro-dataset
MUJOCO_GL=egl
PYOPENGL_PLATFORM=egl
# LIBERO init-state files are trusted, revision-pinned Torch pickles.
TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
# Historical RLinf-driver profiles only; the direct driver never reads it.
# RLINF_ROOT=/absolute/path/to/pinned/RLinf
# Device selection comes from the execution-resource slot a RunSpec binds;
# set these only for an unprofiled, host-exclusive run.
# CUDA_VISIBLE_DEVICES=0
# MUJOCO_EGL_DEVICE_ID=0

# Resident SAM3 and Contact-GraspNet services (scripts/model-services start).
# GPU values are physical indices; ports are loopback-only.
B2_SAM_PYTHON=/absolute/path/to/perception/python
B2_SAM_ROOT=/absolute/path/to/cap-x/capx/third_party/sam3
B2_SAM_CHECKPOINT=/absolute/path/to/models/sam3.pt
B2_SAM_GPU=0
B2_SAM_PORT=8114
B2_GRASP_PYTHON=/absolute/path/to/perception/python
B2_GRASP_ROOT=/absolute/path/to/cap-x/capx/third_party/contact_graspnet_pytorch
B2_GRASP_CHECKPOINT=/absolute/path/to/cap-x/capx/third_party/contact_graspnet_pytorch/checkpoints/contact_graspnet/checkpoints/model.pt
B2_GRASP_CONFIG=/absolute/path/to/cap-x/capx/third_party/contact_graspnet_pytorch/checkpoints/contact_graspnet/config.yaml
B2_GRASP_GPU=0
B2_GRASP_PORT=8115

# Provider environment. Preflight requires the base URL to equal the selected
# profile's endpoint exactly; a self-hosted model is reached through a loopback
# port forward and its own profile (see the getting-started guide).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_ID=deepseek-flash
# Low profiles (the LIBERO arm, dedicated experiment accounting); keep the
# optional standby pool empty.
DEEPSEEK_LOW_API_KEY=
DEEPSEEK_LOW_API_KEYS=
# High profiles (the RoboTwin arm).
DEEPSEEK_API_KEY=

# Optional shared Volcengine Agent Plan GLM-5.2 provider.
VOLCENGINE_AGENT_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
VOLCENGINE_AGENT_PLAN_MODEL_ID=glm-5.2
# VOLCENGINE_AGENT_PLAN_API_KEY=

