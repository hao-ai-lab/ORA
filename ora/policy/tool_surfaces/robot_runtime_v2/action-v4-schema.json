{
  "robot.submit_action": {
    "type": "object",
    "properties": {
      "arm": {"type": "string", "enum": ["left", "right"]},
      "pose": {
        "type": ["object", "null"],
        "properties": {
          "position_m": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 3,
            "maxItems": 3
          },
          "orientation_xyzw": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": ["position_m", "orientation_xyzw"],
        "additionalProperties": false
      },
      "gripper": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
    },
    "required": ["arm"],
    "anyOf": [
      {"required": ["pose"]},
      {"required": ["gripper"]}
    ],
    "additionalProperties": false
  }
}
