      "compiled_pose": {
        "type": "object"
      },
      "view_dimensions": {
        "type": "object"
      }
    },
    "required": [
      "status",
      "preview_id",
      "views",
      "compiled_pose",
      "view_dimensions"
    ],
    "additionalProperties": false
  },
  "move_pose": {
    "type": "object",
    "properties": {
