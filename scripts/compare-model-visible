#!/usr/bin/env python3
"""Compare what two commits let the model see across a fixed RunSpec matrix.

    scripts/compare-model-visible BASE CANDIDATE [--json REPORT] [--keep]

Each commit's tree is extracted with ``git archive`` into a scratch directory
under ``$TMPDIR`` and resolved by that tree's own ``resolve_run_spec`` in a
child process whose ``ORA_WORKSPACE_ROOT`` is a fresh scratch
directory. ``resolve_run_spec`` runs ``git rev-parse HEAD`` and ``git status``,
so every extracted tree is committed once into a throwaway repository; its
commit id differs from the real one and ``source`` is not compared.

For every cell the five items of ``ora/orchestrator/model_visible.py``
-- advertised composition, prompt-layer texts, embodiment card and projected
facts, observation projection, and the masked policy/runtime/budgets blocks --
are computed from the resolved plan with the module in this script's own
checkout, so a base commit that predates ``policy_identity.model_visible_sha256`` is
compared the same way. Card rendering uses each tree's own code. Both trees
run in this checkout's locked environment (``.venv``).

Exit 0 when no compared cell differs, 1 on any difference, 2 on usage or
extraction errors or when no cell resolved at both commits.
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any, Callable

ROOT = Path(__file__).resolve().parents[1]
ITEMS = ("advertised", "prompt_layers", "embodiment", "observation_projection", "settings")
INSTRUCTION = "Move the selected object to the destination."
DETAIL_LIMIT = 12
_GIT_IDENTITY = {
    "GIT_AUTHOR_NAME": "compare-model-visible", "GIT_AUTHOR_EMAIL": "compare@example.invalid",
    "GIT_COMMITTER_NAME": "compare-model-visible", "GIT_COMMITTER_EMAIL": "compare@example.invalid",
    "GIT_AUTHOR_DATE": "2000-01-01T00:00:00Z", "GIT_COMMITTER_DATE": "2000-01-01T00:00:00Z",
}


class CompareError(RuntimeError):
    """A commit cannot be extracted or resolved."""


# ---- the RunSpec matrix (runs inside the extracted tree) -------------------------

def _policy(kind: str) -> dict[str, Any]:
    policy: dict[str, Any] = {"kind": kind, "model": "equivalence-model", "supports_images": True,
                              "context_window_tokens": 262144, "max_output_tokens": 8192}
    policy.update(provider="openai_compatible", endpoint="https://example.invalid/v1")
    return policy


def _spec(config: str, policy: dict[str, Any], runtime: dict[str, Any], **extra: Any) -> dict[str, Any]:
    return {
        "schema": "ora.run-spec.v1", "experiment": "model-visible-equivalence",
        "config": config, "milestone": "EQUIV", "task": "equivalence-task", "task_instruction": INSTRUCTION,
        "seed": 0, "evidence_tier": "diagnostic", "output_workspace": "outputs/model-visible-equivalence",
        "policy": policy, "runtime": runtime,
        "budgets": {"max_robot_decisions": 80, "max_model_calls": 200, "max_sim_steps": 10000, "wall_time_s": 600},
        **extra,
    }


def _default_spec(environment: str, kind: str) -> dict[str, Any]:
    runtime: dict[str, Any] = {"kind": environment}
    if environment == "libero_pro":
        runtime.update(suite="libero_spatial", task_id=0, expected_task_language=INSTRUCTION,
                       motion_planner={"device": "cuda:0"})
    return _spec(f"{environment}-{kind}", _policy(kind), runtime)


def _robodojo_default_spec(tree: Path, task: str = "stack_bowls") -> dict[str, Any]:
    """A fresh RoboDojo RunSpec naming no surface: the default (direct_v4) RoboDojo instance."""
    from ora.agent.composition.robodojo_task_contract import REGISTRY_PATH, load_task_contract
    from ora.environment.benchmarks.robodojo import NATIVE_ACTION_LIMITS
    from ora.environment.benchmarks.robodojo_physics import physics_device_for

    entry = json.loads((tree / REGISTRY_PATH).read_text())["tasks"][task]
    record = load_task_contract(task, bindings={task: entry}, project_root=tree)["record"]
    layout, instruction = record["layout"], record["instruction"]["text"]
    spec = _spec("robodojo-native_api", _policy("native_api"), {
        "kind": "robodojo", "task_variant": task, "eval_seed": layout["eval_seed"],
        "layout_id": layout["ordinal"], "layout_file": layout["layout_file"],
        "layout_sha256": layout["layout_sha256"], "native_action_limit": NATIVE_ACTION_LIMITS[task],
        "physics_device": physics_device_for(task), "renderer_gpu": 0, "cuda_visible_devices": "0",
        "expected_task_language": instruction,
        "infrastructure_qualification": {"path": "robodojo-compat/qualification/fixture.json",
                                         "sha256": "0" * 64},
    })
    spec.update(task=task, task_instruction=instruction)
    return spec


def matrix(tree: Path) -> dict[str, Callable[[], dict[str, Any]]]:
    """The fixed cells: a fresh default RunSpec on each of the three backends."""

    cells: dict[str, Callable[[], dict[str, Any]]] = {}
    for environment in ("libero_pro", "robotwin"):
        cells[f"direct_v4/{environment}/native_api"] = (
            lambda e=environment: _default_spec(e, "native_api"))
    cells["direct_v4/robodojo/native_api"] = lambda: _robodojo_default_spec(tree)
    return dict(sorted(cells.items()))


def resolve_tree(tree: Path, output: Path) -> int:
    """Child mode: resolve the matrix with ``tree``'s own code; write the items."""

    tree = tree.resolve()
    workspace = Path(os.environ["ORA_WORKSPACE_ROOT"]).resolve()
    sys.path.insert(0, str(tree))
    import ora
    from ora.orchestrator import paths

    if not Path(ora.__file__).resolve().is_relative_to(tree):
        raise CompareError(f"ora imported from {ora.__file__}, not {tree}")
    if paths.resolve_workspace_root() != workspace:
        raise CompareError("the child Runtime workspace is not the isolated scratch workspace")
    loader = importlib.util.spec_from_file_location(
        "_compare_model_visible_items", ROOT / "ora/orchestrator/model_visible.py")
    items_module = importlib.util.module_from_spec(loader)
    loader.loader.exec_module(items_module)
    from ora.orchestrator.spec import resolve_run_spec

    cells: dict[str, Any] = {}
    for cell, build in matrix(tree).items():
        try:
            plan = resolve_run_spec(build(), root=tree)
        except Exception as exc:  # recorded per cell; the comparison reports it
            cells[cell] = {"status": "unresolved", "error": f"{type(exc).__name__}: {str(exc)[:400]}"}
            continue
        items = items_module.model_visible_items(plan, root=tree)
        cells[cell] = {
            "status": "resolved", "items": items,
            "model_visible_sha256": items_module.canonical_sha256(items),
            "recorded_model_visible_sha256": plan.get("policy_identity", {}).get("model_visible_sha256"),
            "tool_surface": plan["policy"].get("tool_surface", {}).get("profile"),
        }
    output.write_text(json.dumps({"tree": str(tree), "cells": cells}, sort_keys=True), encoding="utf-8")
    return 0


# ---- extraction and comparison (runs in this checkout) ---------------------------

def _git(*args: str, cwd: Path = ROOT, env: dict[str, str] | None = None) -> subprocess.CompletedProcess:
    result = subprocess.run(["git", *args], cwd=cwd, capture_output=True, timeout=600, check=False,
                            env={**os.environ, **(env or {})})
    if result.returncode:
        raise CompareError(result.stderr.decode(errors="replace").strip() or f"git {args[0]} failed")
    return result


def extract(commit: str, destination: Path) -> str:
    """Write ``commit``'s tree to ``destination`` as a one-commit throwaway repository."""

    revision = _git("rev-parse", "--verify", f"{commit}^{{commit}}").stdout.decode().strip()
    archive = _git("archive", "--format=tar", revision).stdout
    destination.mkdir(parents=True)
    unpacked = subprocess.run(["tar", "-x", "-C", str(destination)], input=archive,
                              capture_output=True, timeout=600, check=False)
    if unpacked.returncode:
        raise CompareError(f"cannot unpack {revision}: {unpacked.stderr.decode(errors='replace').strip()}")
    for args in (("init", "-q"), ("add", "-A", "-f"),
                 ("-c", "commit.gpgsign=false", "-c", "core.hooksPath=/dev/null",
                  "commit", "-q", "--no-verify", "-m", f"tree of {revision}")):
        _git(*args, cwd=destination, env=_GIT_IDENTITY)
    return revision


def resolve(commit: str, scratch: Path, label: str) -> dict[str, Any]:
    tree, workspace = scratch / label / "tree", scratch / label / "workspace"
    revision = extract(commit, tree)
    workspace.mkdir(parents=True)
    output = scratch / label / "cells.json"
    python = ROOT / ".venv/bin/python"
    command = [str(python if python.is_file() else Path(sys.executable)), str(tree / "scripts/compare-model-visible"),
               "--resolve-tree", str(tree), "--output", str(output)]
    # claude_code binds the executable `claude` on PATH; both commits find the
    # same stub, and the bound path and hash are pins the items mask.
    env = {**os.environ, "ORA_WORKSPACE_ROOT": str(workspace),
           "ROBOT_HARNESS_WORKSPACE_ROOT": str(workspace), "PYTHONPATH": str(tree),
           "PYTHONDONTWRITEBYTECODE": "1", "PATH": f"{scratch / 'bin'}{os.pathsep}{os.environ.get('PATH', '')}"}
    result = subprocess.run(command, cwd=tree, env=env, capture_output=True, text=True, timeout=1800, check=False)
    if result.returncode or not output.is_file():
        raise CompareError(f"{label} {revision[:12]} did not resolve: {result.stderr.strip()[-2000:]}")
    return {"commit": revision, **json.loads(output.read_text(encoding="utf-8"))}


def _canonical(value: Any) -> str:
    return json.dumps(value, sort_keys=True, ensure_ascii=False, separators=(",", ":"))


def _paths(base: Any, candidate: Any, prefix: str = "$") -> list[str]:
    """JSON paths where two values differ, depth-first."""

    if isinstance(base, dict) and isinstance(candidate, dict):
        found: list[str] = []
        for key in sorted(set(base) | set(candidate)):
            if key not in base or key not in candidate:
                found.append(f"{prefix}.{key} ({'added' if key in candidate else 'removed'})")
            else:
                found.extend(_paths(base[key], candidate[key], f"{prefix}.{key}"))
        return found
    if isinstance(base, list) and isinstance(candidate, list) and len(base) == len(candidate):
        return [path for index, (a, b) in enumerate(zip(base, candidate))
                for path in _paths(a, b, f"{prefix}[{index}]")]
    return [] if _canonical(base) == _canonical(candidate) else [prefix]


def item_details(item: str, base: Any, candidate: Any) -> list[str]:
    """Human-readable differences of one item; tool definitions are named."""

    if item == "advertised":
        named = lambda value: {row.get("name"): row for row in value.get("definitions", [])}
        before, after = named(base), named(candidate)
        details = [f"tool added: {name}" for name in sorted(set(after) - set(before))]
        details += [f"tool removed: {name}" for name in sorted(set(before) - set(after))]
        details += [f"tool definition differs: {name}" for name in sorted(set(before) & set(after))
                    if _canonical(before[name]) != _canonical(after[name])]
        if [row.get("name") for row in base.get("definitions", [])] != [
                row.get("name") for row in candidate.get("definitions", [])]:
            details.append("tool order differs")
        rest = lambda value: {key: entry for key, entry in value.items() if key != "definitions"}
        return details + _paths(rest(base), rest(candidate), "$advertised")
    return _paths(base, candidate, f"${item}")


def compare(base: dict[str, Any], candidate: dict[str, Any]) -> dict[str, Any]:
    cells: dict[str, Any] = {}
    for cell in sorted(set(base["cells"]) | set(candidate["cells"])):
        before, after = base["cells"].get(cell), candidate["cells"].get(cell)
        statuses = (before or {}).get("status", "absent"), (after or {}).get("status", "absent")
        if statuses != ("resolved", "resolved"):
            same = statuses[0] == statuses[1] and (before or {}).get("error") == (after or {}).get("error")
            cells[cell] = {"result": "unresolved_at_both" if same else "different",
                           "details": [f"base {statuses[0]}: {(before or {}).get('error', '')}",
                                       f"candidate {statuses[1]}: {(after or {}).get('error', '')}"]}
            continue
        details = [f"{item}: {line}" for item in ITEMS if _canonical(before["items"][item]) != _canonical(after["items"][item])
                   for line in item_details(item, before["items"][item], after["items"][item]) or ["differs"]]
        notes = [f"{label} recorded model_visible_sha256 {entry['recorded_model_visible_sha256']} "
                 f"differs from the recomputed {entry['model_visible_sha256']}"
                 for label, entry in (("base", before), ("candidate", after))
                 if entry.get("recorded_model_visible_sha256")
                 and entry["recorded_model_visible_sha256"] != entry["model_visible_sha256"]]
        cells[cell] = {"result": "different" if details else "same", "details": details, "notes": notes,
                       "model_visible_sha256": [before["model_visible_sha256"], after["model_visible_sha256"]]}
    return cells


def report(base: dict[str, Any], candidate: dict[str, Any], cells: dict[str, Any]) -> int:
    print(f"base      {base['commit']}")
    print(f"candidate {candidate['commit']}")
    for cell, entry in cells.items():
        digests = entry.get("model_visible_sha256")
        suffix = f"  {digests[0][:12]} -> {digests[1][:12]}" if digests else ""
        print(f"{entry['result']:<19} {cell}{suffix}")
        for line in [*entry["details"][:DETAIL_LIMIT], *entry.get("notes", [])]:
            print(f"    {line}")
        if len(entry["details"]) > DETAIL_LIMIT:
            print(f"    ... {len(entry['details']) - DETAIL_LIMIT} more")
    counts = {result: sum(entry["result"] == result for entry in cells.values())
              for result in ("same", "different", "unresolved_at_both")}
    print(f"model-visible equivalence: {len(cells)} cells, {counts['same']} same, "
          f"{counts['different']} different, {counts['unresolved_at_both']} unresolved at both")
    if counts["different"]:
        return 1
    return 0 if counts["same"] else 2


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("base", nargs="?")
    parser.add_argument("candidate", nargs="?")
    parser.add_argument("--json", type=Path, help="also write the full comparison report here")
    parser.add_argument("--keep", action="store_true", help="keep the extracted trees and workspaces")
    parser.add_argument("--resolve-tree", type=Path, help=argparse.SUPPRESS)
    parser.add_argument("--output", type=Path, help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    if args.resolve_tree is not None:
        return resolve_tree(args.resolve_tree, args.output)
    if not args.base or not args.candidate:
        parser.error("BASE and CANDIDATE commits are required")
    scratch = Path(tempfile.mkdtemp(prefix="compare-model-visible-"))
    try:
        stub = scratch / "bin" / "claude"
        stub.parent.mkdir()
        stub.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
        stub.chmod(0o755)
        base = resolve(args.base, scratch, "base")
        candidate = resolve(args.candidate, scratch, "candidate")
        cells = compare(base, candidate)
        if args.json:
            args.json.write_text(json.dumps({"base": base["commit"], "candidate": candidate["commit"],
                                             "cells": cells}, indent=2, sort_keys=True) + "\n")
        return report(base, candidate, cells)
    except CompareError as exc:
        print(f"compare-model-visible: {exc}", file=sys.stderr)
        return 2
    finally:
        if args.keep:
            print(f"kept scratch trees in {scratch}", file=sys.stderr)
        else:
            shutil.rmtree(scratch, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
