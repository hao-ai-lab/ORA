#!/usr/bin/env sh
# Compile current-identity Viewer videos outside canonical run evidence.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT"

if [ -x "$ROOT/.venv/bin/python" ]; then
  exec "$ROOT/.venv/bin/python" -m viewer.app --compile-videos "$@"
fi

if command -v uv >/dev/null 2>&1; then
  exec uv run --locked python -m viewer.app --compile-videos "$@"
fi

PYTHON=${PYTHON:-python3}
exec "$PYTHON" -m viewer.app --compile-videos "$@"
