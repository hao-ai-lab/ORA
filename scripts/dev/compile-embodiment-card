#!/usr/bin/env sh
# Create, validate or compile a policy-safe embodiment descriptor.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT"

if [ -x "$ROOT/.venv/bin/python" ]; then
  exec "$ROOT/.venv/bin/python" -m ora.agent.composition.embodiment "$@"
fi

if command -v uv >/dev/null 2>&1; then
  exec uv run --locked python -m ora.agent.composition.embodiment "$@"
fi

PYTHON=${PYTHON:-python3}
exec "$PYTHON" -m ora.agent.composition.embodiment "$@"
