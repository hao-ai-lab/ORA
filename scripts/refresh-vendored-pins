#!/usr/bin/env python3
"""Recompute the vendored RoboTwin hash cascade for the current control profile.

The deterministic install revision is a pure function of the tracked vendored
payloads (``ora/environment/backends/robotwin/vendored/``), the
pinned vanilla upstream revision and the fixed installer identity/message.
Whenever a vendored payload changes, this script recomputes that revision with
the same ``read-tree``/``hash-object``/``commit-tree`` flow the installer's
``git commit`` reproduces, then rewrites the current pin sites:

- ``INSTALL_REVISION`` in ``vendored_install.py``;
- the vendored ``source_binding`` fields of the current ALOHA control profile
  (``control-profile-v10.json``);
- the ``FROZEN_CONTROL_PROFILE_SHA256`` current-version entry.

Every rewrite is anchored on the surrounding constant name or JSON key and
must match exactly once; a missing anchor fails instead of silently skipping.
Historical pins (v1-v9 profiles, test citations and
``HISTORICAL_*``/``LEGACY_*`` constants) describe sealed evidence and are never
touched. The script is idempotent: when
all pins already carry the recomputed values it reports a no-op and changes
nothing. It only writes repository text files; it never runs a simulator, and
the upstream clone is a read-only alternate object database. All new objects
and the temporary index live in a disposable bare repository.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Mapping

REPO_ROOT = Path(__file__).resolve().parents[1]

DEFAULT_ROBOTWIN_GIT = Path(os.environ.get("ROBOTWIN_ROOT", "RoboTwin"))

_HEX40 = "[0-9a-f]{40}"
_HEX64 = "[0-9a-f]{64}"

#: Relative pin-site paths inside the project root.
INSTALLER_PATH = "ora/environment/backends/robotwin/vendored_install.py"
CURRENT_PROFILE_PATH = (
    "ora/policy/embodiments/aloha-agilex/control-profile-v10.json"
)
MOTION_TEST_PATH = "tests/test_motion_transaction_v1.py"
CAPABILITIES_PATH = (
    "ora/environment/controllers/profile_capabilities.py"
)


class RefreshError(RuntimeError):
    """A pin site is missing, ambiguous, or the object flow failed."""


def _git(
    root: Path, *args: str, env: Mapping[str, str] | None = None,
) -> str:
    merged = {**os.environ, **(env or {})}
    result = subprocess.run(
        ["git", "-C", str(root), *args],
        capture_output=True,
        text=True,
        timeout=120,
        check=False,
        env=merged,
    )
    if result.returncode:
        raise RefreshError(
            f"git {' '.join(args)} failed: "
            f"{result.stderr.strip() or result.stdout.strip()}"
        )
    return result.stdout


def compute_install_revision(
    robotwin_git: Path,
    *,
    upstream_revision: str,
    payload_files: Mapping[str, Path],
    commit_identity: Mapping[str, str],
    commit_message: str,
) -> str:
    """Deterministic install commit for the given payloads and base.

    Uses ``robotwin_git`` as a read-only alternate of a temporary bare
    repository. ``read-tree``, payload ``hash-object -w``, ``write-tree`` and
    ``commit-tree`` only write in that temporary repository. No object,
    index, ref or working-tree file in the upstream clone changes.
    """

    root = Path(robotwin_git).resolve()
    if not (root / ".git").exists() and not (root / "HEAD").is_file():
        raise RefreshError(f"not a git repository: {root}")
    source_objects = Path(_git(
        root, "rev-parse", "--path-format=absolute", "--git-path", "objects",
    ).strip()).resolve()
    with tempfile.TemporaryDirectory(prefix="refresh-vendored-pins-") as tmp:
        temporary = Path(tmp)
        bare = temporary / "objects.git"
        _git(temporary, "init", "--bare", "--quiet", str(bare))
        (bare / "objects/info/alternates").write_text(str(source_objects) + "\n")
        index_env = {"GIT_INDEX_FILE": str(Path(tmp) / "index")}
        _git(bare, "read-tree", upstream_revision, env=index_env)
        for target, payload in payload_files.items():
            payload_path = Path(payload)
            if not payload_path.is_file():
                raise RefreshError(f"vendored payload missing: {payload_path}")
            blob = _git(bare, "hash-object", "-w", str(payload_path)).strip()
            _git(
                bare,
                "update-index", "--add", "--cacheinfo",
                f"100644,{blob},{target}",
                env=index_env,
            )
        tree = _git(bare, "write-tree", env=index_env).strip()
        return _git(
            bare,
            "commit-tree", tree, "-p", upstream_revision,
            "-m", commit_message,
            env=commit_identity,
        ).strip()


def _rewrite(
    path: Path, replacements: list[tuple[str, str]],
) -> bool:
    """Apply anchored replacements to one file; return True when it changed.

    Each pattern must contain groups ``(anchor)(value)`` and match exactly
    once, so a drifted or duplicated pin site fails loudly instead of being
    skipped or over-written.
    """

    if not path.is_file():
        raise RefreshError(f"pin site missing: {path}")
    text = original = path.read_text(encoding="utf-8")
    for pattern, value in replacements:
        matches = list(re.finditer(pattern, text, flags=re.MULTILINE))
        if len(matches) != 1:
            raise RefreshError(
                f"anchor matched {len(matches)} times (expected 1) "
                f"in {path}: {pattern!r}"
            )
        match = matches[0]
        text = text[: match.start(2)] + value + text[match.end(2):]
    if text != original:
        path.write_text(text, encoding="utf-8")
        return True
    return False


def apply_pins(
    project_root: Path, binding: Mapping[str, str],
) -> dict[str, object]:
    """Rewrite current pin sites without touching historical experiment records.

    ``binding`` carries the four vendored source-binding values (the exact
    ``expected_profile_source_binding()`` shape). The current-profile sha256
    cascade is recomputed from the rewritten JSON bytes. Returns the changed
    relative paths and the resulting profile sha256.
    """

    root = Path(project_root).resolve()
    revision = binding["robotwin_revision"]
    changed: list[str] = []

    def _apply(relative: str, replacements: list[tuple[str, str]]) -> None:
        if _rewrite(root / relative, replacements):
            changed.append(relative)

    _apply(INSTALLER_PATH, [
        (rf'(^INSTALL_REVISION = ")({_HEX40})(")', revision),
    ])
    _apply(CURRENT_PROFILE_PATH, [
        (rf'("robotwin_revision": ")({_HEX40})(")', revision),
        (
            rf'("planner_adapter_sha256": ")({_HEX64})(")',
            binding["planner_adapter_sha256"],
        ),
        (
            rf'("robot_adapter_sha256": ")({_HEX64})(")',
            binding["robot_adapter_sha256"],
        ),
        (
            rf'("planner_attribution_sha256": ")({_HEX64})(")',
            binding["planner_attribution_sha256"],
        ),
    ])
    profile_sha256 = hashlib.sha256(
        (root / CURRENT_PROFILE_PATH).read_bytes()
    ).hexdigest()
    _apply(CAPABILITIES_PATH, [
        (rf'(^    10: ")({_HEX64})(",)', profile_sha256),
    ])
    return {"changed": changed, "profile_sha256": profile_sha256}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Recompute the deterministic vendored-planner install revision "
            "and rewrite current pin sites; idempotent no-op when "
            "nothing moved."
        )
    )
    parser.add_argument(
        "--robotwin-git",
        type=Path,
        default=DEFAULT_ROBOTWIN_GIT,
        help=(
            "upstream RoboTwin clone used only as a git object database "
            f"(default: {DEFAULT_ROBOTWIN_GIT})"
        ),
    )
    parser.add_argument(
        "--project-root",
        type=Path,
        default=REPO_ROOT,
        help="repository root whose pin sites are rewritten",
    )
    args = parser.parse_args(argv)

    # Load the stdlib-only installer module directly so this script does not
    # depend on the project virtualenv (the package __init__ chain imports
    # numpy). The vendored constants stay single-sourced in that file.
    spec = importlib.util.spec_from_file_location(
        "ora_vendored_install", REPO_ROOT / INSTALLER_PATH,
    )
    assert spec is not None and spec.loader is not None
    vendored_install = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(vendored_install)

    payloads = {
        target: vendored_install.VENDORED_ROOT / name
        for target, name in vendored_install.VENDORED_FILES.items()
    }
    revision = compute_install_revision(
        args.robotwin_git,
        upstream_revision=vendored_install.UPSTREAM_REVISION,
        payload_files=payloads,
        commit_identity=vendored_install._COMMIT_IDENTITY,
        commit_message=vendored_install._COMMIT_MESSAGE,
    )
    digests = vendored_install.vendored_file_sha256()
    binding = {
        "robotwin_revision": revision,
        "planner_adapter_sha256": digests["envs/robot/planner.py"],
        "robot_adapter_sha256": digests["envs/robot/robot.py"],
        "planner_attribution_sha256": digests["CAPX_MIT_ATTRIBUTION.md"],
    }
    try:
        result = apply_pins(args.project_root, binding)
    except RefreshError as exc:
        print(f"FAIL {exc}", file=sys.stderr)
        return 1
    print(json.dumps({
        "install_revision": revision,
        "profile_sha256": result["profile_sha256"],
        "planner_adapter_sha256": binding["planner_adapter_sha256"],
    }, indent=2, sort_keys=True))
    if result["changed"]:
        print("rewritten:")
        for relative in result["changed"]:
            print(f"  {relative}")
    else:
        print("no-op: every pin already matches the recomputed cascade")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
